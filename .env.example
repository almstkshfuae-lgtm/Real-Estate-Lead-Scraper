## Example MySQL DATABASE_URL with connection pool and socket timeout settings
## Increase `connection_limit` from 2 -> 10 and `socket_timeout` from 20000ms -> 60000ms
## Note: Some providers expect timeout values in milliseconds.
## Example:
## DATABASE_URL="mysql://user:password@host:3306/dbname?connection_limit=10&socket_timeout=60000"
# Local and production environment configuration.
# For local testing with Vercel environment values, use:
#   npx vercel env pull .env.local
# or copy the required keys from Vercel into your local .env.local file.
DATABASE_URL=
JWT_SECRET=
GOOGLE_AI_API_KEY=
BLOB_READ_WRITE_TOKEN=
BITRIX24_DOMAIN=
BITRIX24_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Scraper
SCRAPER_SERVICE_URL=
SCRAPER_SECRET=
PROXY_SERVICE_URL=
PROXY_API_KEY=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_REDIRECT_URI=
NEXT_PUBLIC_DEFAULT_BUDGET_MIN=1000000
NEXT_PUBLIC_DEFAULT_BUDGET_MAX=10000000
