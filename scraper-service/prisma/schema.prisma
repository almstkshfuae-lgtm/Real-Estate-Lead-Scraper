generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String
  nameAr        String?
  role          String          @default("agent")
  theme         String          @default("system")
  language      String          @default("en")
  createdAt     DateTime        @default(now())
  preferences   String?         @db.Text
  chatHistory   ChatMessage[]
  exports       ExportHistory[]
  leads         Lead[]
  notifications Notification[]
  searches      Search[]
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  nameAr       String?
  company      String
  companyAr    String?
  role         String
  roleAr       String?
  source       String
  tier         Int
  phone        String?
  email        String?
  location     String
  score        Int
  signals      Json
  propertyPref Json
  budgetMin    Float?
  budgetMax    Float?
  relocated    Boolean   @default(false)
  rentalFlag   Boolean   @default(false)
  status       String    @default("new")
  notes        String?   @db.Text
  bitrix24Id   String?
  agentId      String
  scrapeRunId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  persona      String?   @db.Text
  sourceType   String?
  latitude     Float?
  longitude    Float?
  agent        User      @relation(fields: [agentId], references: [id])
  scrapeRun    ScrapeRun @relation(fields: [scrapeRunId], references: [id], onDelete: Cascade)

  @@unique([name, company, source, agentId])
  @@index([agentId], map: "Lead_agentId_fkey")
  @@index([scrapeRunId], map: "Lead_scrapeRunId_fkey")
  @@index([source])
  @@map("leads")
}

model SourceConfig {
  id                    String    @id @default(cuid())
  key                   String    @unique
  url                   String
  name                  String
  type                  String
  signals               Json
  navigationSelectors   Json
  contentSelectors      Json
  crawlDepth            Int?
  maxPages              Int?
  delayBetweenPages     Int?
  active                Boolean   @default(true)
  verificationStatus    String    @default("pending")
  verificationReport    String?   @db.Text
  verifiedAt            DateTime?
  technicalAccessPassed Boolean?
  domDataPassed         Boolean?
  interactionsPassed    Boolean?
  aiExtractionPassed    Boolean?
  verificationNotes     String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ScrapeRun {
  id          String    @id @default(cuid())
  triggeredBy String
  sources     String
  criteria    String
  status      String
  leadsFound  Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  logUrl      String?
  leads       Lead[]
}

model Search {
  id        String   @id @default(cuid())
  agentId   String
  criteria  String
  createdAt DateTime @default(now())
  agent     User     @relation(fields: [agentId], references: [id])

  @@index([agentId], map: "Search_agentId_fkey")
}

model ChatMessage {
  id        String   @id @default(cuid())
  agentId   String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  agent     User     @relation(fields: [agentId], references: [id])

  @@index([agentId], map: "ChatMessage_agentId_fkey")
}

model ExportHistory {
  id          String   @id @default(cuid())
  agentId     String
  format      String
  filters     String
  recordCount Int
  fileUrl     String
  createdAt   DateTime @default(now())
  agent       User     @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model Notification {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  body      String
  type      String
  data      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  agent     User     @relation(fields: [agentId], references: [id])

  @@index([agentId])
}
