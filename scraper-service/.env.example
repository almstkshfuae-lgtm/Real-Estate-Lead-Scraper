# Scraper Service Configuration
PORT=3002
SCRAPER_SECRET=scraper_secret_alpha_bravo
NODE_ENV=development

# DataImpulse Rotating Proxy Configuration
# Get credentials from https://dataimpulse.com
# Format: http://username:password@gw.dataimpulse.com:823
USE_PROXY=true
DATAIMPULSE_PROXY_URL=http://your_username:your_password@gw.dataimpulse.com:823
DATAIMPULSE_PROXY_USERNAME=
DATAIMPULSE_PROXY_PASSWORD=
DATAIMPULSE_PROXY_HOST=gw.dataimpulse.com
DATAIMPULSE_PROXY_PORT=823
DATAIMPULSE_PROXY_SCHEME=http

# For production, use strong secrets:
# SCRAPER_SECRET=use_a_strong_random_string_here_at_least_32_chars

