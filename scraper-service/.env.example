# Scraper Service Configuration
PORT=3002
SCRAPER_SECRET=scraper_secret_alpha_bravo
NODE_ENV=development

# Oxylabs Rotating Proxy Configuration
# Get credentials from https://dashboard.oxylabs.io
# Format: http://username:password@proxy.oxylabs.io:10000
# Or: socks5://username:password@proxy.oxylabs.io:10001
USE_PROXY=true
OXYLABS_PROXY_URL=http://your_username:your_password@pr.oxylabs.io:7777

# For production, use strong secrets:
# SCRAPER_SECRET=use_a_strong_random_string_here_at_least_32_chars

