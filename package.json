{
  "name": "real-estate-lead-scraper",
  "version": "1.0.0",
  "description": "A full-stack real estate lead intelligence platform for UAE agents. Scrapes, scores, qualifies, and pushes buyer leads from 11+ premium sources into Bitrix24 CRM with AI-powered pitch generation, WhatsApp Business outreach, and bilingual EN/AR support.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "build:prod": "npm run prisma:generate && next build",
    "start": "next start",
    "test:e2e": "npx playwright test",
    "playwright:install": "npx playwright install",
    "prisma:generate": "node ./scripts/prisma-generate.js",
    "prisma:migrate:dev": "npx prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:prod": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:db:pull": "npx prisma db pull --schema prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "npx prisma db seed --schema prisma/schema.prisma",
    "seed:dev": "npm run prisma:seed",
    "prisma:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "check:scratch": "tsc -p tsconfig.scratch.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",
