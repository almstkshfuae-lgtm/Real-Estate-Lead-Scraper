# Copy this file to .env.local and fill with real secrets. Do NOT commit real secrets.
# AI provider (one of these is required for /api/ai/chat to work)
GOOGLE_AI_API_KEY=
# or
OPENAI_API_KEY=

# JWT secret used to sign auth tokens (change in production)
JWT_SECRET=change-me-for-production

# Database connection URL used by Prisma
# Example: postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=

# Optional: set PORT if you want to run on a non-default port
PORT=3000
