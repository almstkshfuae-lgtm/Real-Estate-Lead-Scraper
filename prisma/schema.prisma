generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String
  nameAr        String?
  role          String          @default("agent")
  theme         String          @default("system")
  language      String          @default("en")
  createdAt     DateTime        @default(now())
  preferences   String?         @db.Text
  chatHistory   ChatMessage[]
  exports       ExportHistory[]
  leads         Lead[]
  notifications Notification[]
  searches      Search[]
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  nameAr       String?
  company      String
  companyAr    String?
  role         String
  roleAr       String?
  source       String
  tier         Int
  phone        String?
  email        String?
  location     String
  score        Int
  signals      Json
  propertyPref Json
  budgetMin    Float?
  budgetMax    Float?
  relocated    Boolean   @default(false)
  rentalFlag   Boolean   @default(false)
  status       String    @default("new")
  notes        String?   @db.Text
  bitrix24Id   String?
  agentId      String
  scrapeRunId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  persona      String?   @db.Text
  sourceType   String?
  latitude     Float?
  longitude    Float?
  metadata     Json?
  agent        User      @relation(fields: [agentId], references: [id])
  scrapeRun    ScrapeRun @relation(fields: [scrapeRunId], references: [id], onDelete: Cascade)

  @@unique([name, company, source, agentId], map: "Lead_name_company_source_agentId_key")
  @@index([agentId], map: "leads_agentId_fkey")
  @@index([scrapeRunId], map: "leads_scrapeRunId_fkey")
  @@index([source])
  @@index([createdAt])
  @@index([status])
  @@index([tier])
  @@index([score])
  @@index([location])
  @@index([deletedAt])
  @@map("leads")
}

model SourceConfig {
  id                    String    @id @default(cuid())
  key                   String    @unique
  url                   String
  name                  String
  type                  String
  signals               Json
  navigationSelectors   Json
  contentSelectors      Json
  crawlDepth            Int?
  maxPages              Int?
  delayBetweenPages     Int?
  active                Boolean   @default(true)
  verificationStatus    String    @default("pending")
  verificationReport    String?   @db.Text
  verifiedAt            DateTime?
  technicalAccessPassed Boolean?
  domDataPassed         Boolean?
  interactionsPassed    Boolean?
  aiExtractionPassed    Boolean?
  verificationNotes     String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ScrapeRun {
  id          String    @id @default(cuid())
  triggeredBy String
  sources     String    @db.Text
  criteria    String    @db.Text
  status      String
  leadsFound  Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  logUrl      String?
  leads       Lead[]
}

model Search {
  id        String   @id @default(cuid())
  agentId   String
  criteria  String @db.Text
  createdAt DateTime @default(now())
  agent     User     @relation(fields: [agentId], references: [id])

  @@index([agentId], map: "Search_agentId_fkey")
}

model ChatMessage {
  id        String   @id @default(cuid())
  agentId   String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  agent     User     @relation(fields: [agentId], references: [id])

  @@index([agentId], map: "ChatMessage_agentId_fkey")
}

model ExportHistory {
  id          String   @id @default(cuid())
  agentId     String
  format      String
  filters     String
  recordCount Int
  fileUrl     String
  createdAt   DateTime @default(now())
  agent       User     @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model Notification {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  body      String   @db.Text
  type      String
  data      String?  @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  agent     User     @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // "CREATE", "UPDATE", "SOFT_DELETE", "MERGE", "CRM_PUSH", "EXPORT", "RETENTION_CLEANUP"
  entityType String   // "Lead"
  entityId   String
  agentId    String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([agentId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProjectHeatmap {
  id            String   @id @default(cuid())
  projectName   String
  location      String
  developer     String?
  startingPrice Float?
  handoverDate  String?
  propertyType  String?
  areaSqft      Int?
  latitude      Float?
  longitude     Float?
  imageUrl      String?  @db.Text
  sourceUrl     String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([location])
  @@map("project_heatmaps")
}

model AiUsageLog {
  id               String   @id @default(cuid())
  taskType         String   // pitch | score | signals | chat | extraction | persona | projects
  model            String   // e.g. gemini-2.5-flash
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0)
  inputChars       Int      @default(0)
  truncated        Boolean  @default(false)
  success          Boolean  @default(true)
  errorMessage     String?  @db.Text
  agentId          String?
  durationMs       Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([taskType])
  @@index([agentId])
  @@map("ai_usage_logs")
}
